# Postgres (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/theone

# Login
APP_PASSWORD=dein-passwort
AUTH_SECRET=mindestens-32-zufaellige-zeichen

# Railway Bucket (S3-kompatibel)
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# nur für lokale S3-Emulatoren (MinIO/moto) auf true setzen
S3_FORCE_PATH_STYLE=false

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Zeitzone für Erinnerungen & "heute"
TZ=Europe/Berlin
